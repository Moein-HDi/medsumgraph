# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: any model id available on OpenRouter. Used for QA and as the
# default for KG construction. The paper used Llama 3.1 70B.
# See https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
# Optional: cheaper/smaller model for KG construction (Phase 1). Falls back
# to OPENROUTER_MODEL if unset. Triple extraction is a simple structured
# task, so a 8B-20B model works well and is ~5-10x cheaper than 70B.
# Examples: openai/gpt-oss-20b (free), meta-llama/llama-3.1-8b-instruct
KG_LLM_MODEL=openai/gpt-oss-20b
