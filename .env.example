# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional Liara fallback (used when Groq keeps failing, e.g. rate limits).
# Liara gives you a per-project base URL like https://ai.liara.ir/api/<PROJECT_ID>/v1
LIARA_API_KEY=
LIARA_BASE_URL=https://ai.liara.ir/api/CHANGE_ME/v1
LIARA_MODEL=meta-llama/llama-3.3-70b-instruct
